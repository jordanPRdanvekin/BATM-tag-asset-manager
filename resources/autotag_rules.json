{
  "schema_version": 1,
  "rules": [
    {
      "rule_id": "builtin-mesh",
      "name": "Mesh object",
      "match_field": "object_type",
      "match_values": ["MESH"],
      "add_tags": ["Mesh"],
      "match_mode": "EXACT",
      "priority": 10,
      "enabled": true
    },
    {
      "rule_id": "builtin-collection",
      "name": "Collection asset",
      "match_field": "id_type",
      "match_values": ["COLLECTION"],
      "add_tags": ["Collection"],
      "match_mode": "EXACT",
      "priority": 20,
      "enabled": true
    },
    {
      "rule_id": "builtin-material",
      "name": "Material asset",
      "match_field": "id_type",
      "match_values": ["MATERIAL"],
      "add_tags": ["Material"],
      "match_mode": "EXACT",
      "priority": 20,
      "enabled": true
    },
    {
      "rule_id": "builtin-world",
      "name": "World asset",
      "match_field": "id_type",
      "match_values": ["WORLD"],
      "add_tags": ["World"],
      "match_mode": "EXACT",
      "priority": 20,
      "enabled": true
    },
    {
      "rule_id": "builtin-light",
      "name": "Light asset",
      "match_field": "object_type",
      "match_values": ["LIGHT"],
      "add_tags": ["Lighting"],
      "match_mode": "EXACT",
      "priority": 20,
      "enabled": true
    },
    {
      "rule_id": "builtin-armature",
      "name": "Armature / Rig asset",
      "match_field": "object_type",
      "match_values": ["ARMATURE"],
      "add_tags": ["Rig"],
      "match_mode": "EXACT",
      "priority": 20,
      "enabled": true
    },
    {
      "rule_id": "builtin-camera",
      "name": "Camera asset",
      "match_field": "object_type",
      "match_values": ["CAMERA"],
      "add_tags": ["Camera"],
      "match_mode": "EXACT",
      "priority": 20,
      "enabled": true
    },
    {
      "rule_id": "builtin-nature",
      "name": "Recognized nature terms",
      "match_field": "name_tokens",
      "match_values": ["tree", "oak", "pine", "rock", "plant", "flower", "grass", "forest", "bush", "leaf"],
      "add_tags": ["Nature"],
      "match_mode": "ANY",
      "priority": 50,
      "enabled": true
    },
    {
      "rule_id": "builtin-furniture",
      "name": "Recognized furniture terms",
      "match_field": "name_tokens",
      "match_values": ["chair", "table", "sofa", "desk", "cabinet", "shelf", "bed", "lamp"],
      "add_tags": ["Furniture"],
      "match_mode": "ANY",
      "priority": 50,
      "enabled": true
    },
    {
      "rule_id": "builtin-vehicle",
      "name": "Recognized vehicle terms",
      "match_field": "name_tokens",
      "match_values": ["car", "truck", "bike", "vehicle", "aircraft", "boat", "ship", "motorcycle"],
      "add_tags": ["Vehicle"],
      "match_mode": "ANY",
      "priority": 50,
      "enabled": true
    },
    {
      "rule_id": "builtin-rigify",
      "name": "Rigify rig",
      "match_field": "rig_types",
      "match_values": ["RIGIFY"],
      "add_tags": ["Rigify"],
      "match_mode": "EXACT",
      "priority": 30,
      "enabled": true
    },
    {
      "rule_id": "builtin-subdivision",
      "name": "Subdivision modifier",
      "match_field": "modifier_types",
      "match_values": ["SUBSURF"],
      "add_tags": ["Subdivision"],
      "match_mode": "EXACT",
      "priority": 40,
      "enabled": true
    },
    {
      "rule_id": "builtin-bevel",
      "name": "Bevel modifier",
      "match_field": "modifier_types",
      "match_values": ["BEVEL"],
      "add_tags": ["Bevel"],
      "match_mode": "EXACT",
      "priority": 40,
      "enabled": true
    },
    {
      "rule_id": "builtin-lattice",
      "name": "Lattice modifier",
      "match_field": "modifier_types",
      "match_values": ["LATTICE"],
      "add_tags": ["Lattice"],
      "match_mode": "EXACT",
      "priority": 40,
      "enabled": true
    },
    {
      "rule_id": "builtin-shader",
      "name": "Shader / Material names",
      "match_field": "material_names",
      "match_values": ["shader", "bsdf", "material", "glass", "metal", "wood", "fabric"],
      "add_tags": ["Material Assets"],
      "match_mode": "ANY",
      "priority": 45,
      "enabled": true
    },
    {
      "rule_id": "builtin-library-context",
      "name": "Project/environment context",
      "match_field": "library_tag",
      "match_values": ["Comedy Island", "Comedy_Island", "comedy_island", "Comedyisland"],
      "add_tags": ["Comedy Island"],
      "match_mode": "ANY",
      "priority": 15,
      "enabled": true
    },
    {
      "rule_id": "builtin-nature-content",
      "name": "Nature by deep object names",
      "match_field": "object_names",
      "match_values": ["tree", "oak", "pine", "rock", "plant", "flower", "grass", "bush", "leaf", "bark"],
      "add_tags": ["Nature"],
      "match_mode": "ANY",
      "priority": 60,
      "enabled": true
    },
    {
      "rule_id": "builtin-props-content",
      "name": "Props by deep object names",
      "match_field": "object_types",
      "match_values": ["MESH"],
      "add_tags": ["Prop"],
      "match_mode": "ANY",
      "priority": 60,
      "enabled": true
    }
  ]
}
