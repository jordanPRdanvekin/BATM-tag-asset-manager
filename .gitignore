```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled Python files
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
*.dist-info/

# Directories
build/
dist/
*.egg-info/
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/
.tox/
.venv/
venv/
.env
.env.local
.env.*

# Logs
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db
```